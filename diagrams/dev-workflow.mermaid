flowchart TD
    subgraph DA["Claude.ai (Architect)"]
        SPEC[Write SPEC.md\nRequirements and constraints]
        ADR[Architecture Decision Records\nADR-QC-001 through ADR-QC-004]
        BLUE[Produce implementation blueprint\nMethod signatures, design constraints,\ntest cases, interface contracts]
        SPEC --> ADR --> BLUE
    end

    subgraph CC["Claude Code (Implementer)"]
        READ[Read blueprint fully\nbefore writing any code]
        IMPL[Write full implementation\nwith tests]
        TEST[Run tests\nReport results]
        SA[Static analysis\nAST-based security scan]
        DIFF[Generate review.diff\nfor Rob's review session]
        READ --> IMPL --> TEST --> SA --> DIFF
    end

    subgraph GEM["Gemini (Reviewer)"]
        GCR[Code Reviewer Gem\nArchitectural integrity\nNon-negotiables enforcement]
        GSR[SecReview Gem\nSecurity audit\n6 audit categories]
        GDR[Doc Reviewer Gem\nDocumentation clarity\nADR quality]
    end

    subgraph ROB["Rob (Architect + Approver)"]
        GATE[Comprehension Gate\nExplain every design decision\nbefore implementation ships]
        REVIEW[Review implementation\nApprove commit]
    end

    BLUE --> READ
    DIFF --> GCR
    DIFF --> GSR
    DIFF --> ROB
    GCR --> REVIEW
    GSR --> REVIEW
    GATE --> BLUE
    REVIEW --> COMMIT[git commit\nRob approves explicitly]

    style DA fill:#4a90d9,color:#fff
    style CC fill:#e8a838,color:#fff
    style GEM fill:#d96a4a,color:#fff
    style ROB fill:#5ba585,color:#fff
